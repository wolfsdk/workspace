{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolfsdk.com/schemas/pack.v1.schema.json",
  "title": "Wolf pack manifest (pack.wolf.json)",
  "description": "The cross-format binding manifest of a Wolf Workspace pack (wolfsdk.pack.v1). A pack links values of spreadsheet sources (XLSX, or CSV and SQL result snapshots) to targets in Word and PowerPoint documents: a table, a bookmark, a chart series or a fitted headline. Refreshing a pack recalculates each source under its pinned determinism and rewrites every bound target as one reviewable batch per target document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "pack_id", "name", "sources", "bindings"],
  "properties": {
    "contract": {"const": "wolfsdk.pack.v1"},
    "pack_id": {"$ref": "#/$defs/packId"},
    "name": {"$ref": "#/$defs/name"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,62}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceKind": {"enum": ["xlsx", "csv_snapshot", "sql_snapshot"]},
    "determinism": {
      "description": "What a refresh pins so the same sources always give the same bytes: the recalculation clock and seed. A csv_snapshot or sql_snapshot also names the sha256 of the snapshot it was taken from (`snapshot_sha256`); an xlsx source must not.",
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "seed"],
      "properties": {
        "clock": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "seed": {"type": "integer", "minimum": 0},
        "timezone": {"$ref": "#/$defs/name"},
        "locale": {"$ref": "#/$defs/name"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "doc_name", "determinism"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/sourceKind"},
        "doc_name": {"description": "Name of the workspace document holding the source.", "$ref": "#/$defs/name"},
        "determinism": {"$ref": "#/$defs/determinism"}
      }
    },
    "selector_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sheet", "ref"],
      "properties": {
        "type": {"const": "cell"},
        "sheet": {"$ref": "#/$defs/name"},
        "ref": {"type": "string", "pattern": "^\\$?[A-Z]{1,3}\\$?[0-9]{1,7}$"}
      }
    },
    "selector_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sheet", "ref"],
      "properties": {
        "type": {"const": "range"},
        "sheet": {"$ref": "#/$defs/name"},
        "ref": {"type": "string", "pattern": "^\\$?[A-Z]{1,3}\\$?[0-9]{1,7}:\\$?[A-Z]{1,3}\\$?[0-9]{1,7}$"}
      }
    },
    "selector_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {"type": {"const": "table"}, "name": {"$ref": "#/$defs/name"}}
    },
    "selector_defined_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {"const": "defined_name"},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,254}$"}
      }
    },
    "selector": {
      "anyOf": [
        {"$ref": "#/$defs/selector_cell"},
        {"$ref": "#/$defs/selector_range"},
        {"$ref": "#/$defs/selector_table"},
        {"$ref": "#/$defs/selector_defined_name"}
      ]
    },
    "targetFormat": {"enum": ["docx", "pptx"]},
    "targetKind": {"enum": ["docx_table", "docx_bookmark", "pptx_table", "pptx_chart_series", "pptx_fit_headline"]},
    "fitPolicy": {
      "description": "What to do when a bound value does not fit its target. none: write it as is. grow: add table rows. shrink_to_fit: reduce the font down to the target's minimum size. truncate: cut with an ellipsis. fail: refuse the refresh with the target address.",
      "enum": ["none", "grow", "shrink_to_fit", "truncate", "fail"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "selector", "target_doc", "target_format", "target_kind", "target_address", "number_format", "fit_policy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"description": "The id of a source of this pack.", "$ref": "#/$defs/id"},
        "selector": {"$ref": "#/$defs/selector"},
        "target_doc": {"description": "Name of the DOCX or PPTX document to write into.", "$ref": "#/$defs/name"},
        "target_format": {"$ref": "#/$defs/targetFormat"},
        "target_kind": {"$ref": "#/$defs/targetKind"},
        "target_address": {"description": "Agent API address of the target node, or the bookmark name for docx_bookmark.", "$ref": "#/$defs/name"},
        "number_format": {"description": "Excel number format code applied to bound values, or null to keep the source cell's own display format.", "type": ["string", "null"], "minLength": 1},
        "fit_policy": {"$ref": "#/$defs/fitPolicy"}
      }
    }
  }
}
