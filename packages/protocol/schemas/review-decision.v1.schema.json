{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolfsuite.dev/schemas/review-decision.v1.schema.json",
  "title": "WolfSuite review decision file",
  "description": "Per-change approve or reject decisions for one agent-api.v1 transact receipt, written by @wolfsdk/review and built and checked by @wolfsdk/protocol. This file, in sdk/web/packages/protocol/schemas, is the single home of the schema. Decisions bind to the diff identity, so they apply to exactly one semantic diff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "receipt",
    "base_receipt",
    "request_identity",
    "base_sha256",
    "result_sha256",
    "diff_identity",
    "diff_identity_verified",
    "complete",
    "counts",
    "decisions",
    "decided_at"
  ],
  "properties": {
    "contract": {"const": "wolfsuite.review-decision.v1"},
    "receipt": {"$ref": "#/$defs/fileRef"},
    "base_receipt": {"anyOf": [{"$ref": "#/$defs/fileRef"}, {"type": "null"}]},
    "request_identity": {"anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
    "base_sha256": {"$ref": "#/$defs/sha256"},
    "result_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "diff_identity": {"$ref": "#/$defs/identity"},
    "diff_identity_verified": {
      "description": "True when the viewer recomputed sha256 of the canonical JSON of the changes and it equals diff_identity.",
      "type": "boolean"
    },
    "complete": {"description": "True when no decision is pending.", "type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approve", "reject", "pending"],
      "properties": {
        "approve": {"type": "integer", "minimum": 0},
        "reject": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      }
    },
    "decisions": {
      "description": "One entry per transaction.diff.changes item, in diff order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "address", "change", "kind", "decision", "regions"],
        "properties": {
          "index": {"description": "Zero-based index into transaction.diff.changes.", "type": "integer", "minimum": 0},
          "address": {"type": "string", "minLength": 1},
          "change": {"enum": ["added", "removed", "modified", "moved"]},
          "kind": {"type": "string", "minLength": 1},
          "cause": {"type": "integer", "minimum": 0},
          "decision": {"enum": ["approve", "reject", "pending"]},
          "regions": {
            "description": "object_id of the region the change was drawn on, per revision; null when that side has none.",
            "type": "object",
            "additionalProperties": false,
            "required": ["before", "after"],
            "properties": {
              "before": {"type": ["string", "null"]},
              "after": {"type": ["string", "null"]}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "decided_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
