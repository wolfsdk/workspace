{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolfsdk.com/schemas/room.v1.schema.json",
  "title": "Wolf Workspace room snapshot",
  "description": "The state of one collaboration room (wolfsdk.room.v1): its documents with their canonical heads, the append-only session log of committed batches, agent and user proposals, and comment threads. $defs.serverEvent and $defs.clientMessage describe the JSON text messages of the room WebSocket. Every timestamp is an RFC 3339 UTC instant. `seq` is the room event cursor: it grows by one per server event, and a client resumes with room.join `since_seq`.",
  "$ref": "#/$defs/roomState",
  "$defs": {
    "roomState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "room_id", "workspace_id", "seq", "documents", "session_log", "proposals", "comments"],
      "properties": {
        "contract": {"const": "wolfsdk.room.v1"},
        "room_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/id"},
        "seq": {"$ref": "#/$defs/uint"},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
        "session_log": {"type": "array", "items": {"$ref": "#/$defs/sessionEntry"}},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
        "comments": {"type": "array", "items": {"$ref": "#/$defs/thread"}}
      }
    },
    "text": {"type": "string", "minLength": 1},
    "uint": {"type": "integer", "minimum": 0},
    "page": {"description": "1-based page number.", "type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "name": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "optSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "format": {"enum": ["docx", "xlsx", "pptx", "pdf"]},
    "actorKind": {"enum": ["agent", "user"]},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": {"$ref": "#/$defs/actorKind"},
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/name"}
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"$ref": "#/$defs/actorKind"}, "id": {"$ref": "#/$defs/id"}}
    },
    "head": {
      "description": "The canonical head of one document: the last committed revision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256", "format", "name", "updated_at"],
      "properties": {
        "revision": {"$ref": "#/$defs/uint"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"$ref": "#/$defs/format"},
        "name": {"$ref": "#/$defs/name"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head"],
      "properties": {
        "head": {"$ref": "#/$defs/head"},
        "page_hashes": {
          "description": "Page hash of every page of the head revision, in page order (the sha256 of what the page draws).",
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "op": {
      "description": "One Agent API operation, passed to the engine untouched.",
      "type": "object",
      "required": ["op"],
      "properties": {"op": {"$ref": "#/$defs/name"}}
    },
    "batch": {
      "description": "One operation batch. A client may pin any of `clock`, `timezone`, `locale` and `seed` in doc.edit; the server pins the rest when it accepts the batch.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ops"],
      "properties": {
        "ops": {"type": "array", "items": {"$ref": "#/$defs/op"}},
        "label": {"type": "string"},
        "clock": {"$ref": "#/$defs/timestamp"},
        "timezone": {"$ref": "#/$defs/name"},
        "locale": {"$ref": "#/$defs/name"},
        "seed": {"$ref": "#/$defs/uint"}
      }
    },
    "pinnedBatch": {
      "description": "A batch of a proposal or of a session entry. It always names the clock, timezone, locale and seed it ran under, which is what makes replaying a document's entries reproduce its head sha256, and replaying a proposal at approval reproduce its preview.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ops", "clock", "timezone", "locale", "seed"],
      "properties": {
        "ops": {"type": "array", "items": {"$ref": "#/$defs/op"}},
        "label": {"type": "string"},
        "clock": {"$ref": "#/$defs/timestamp"},
        "timezone": {"$ref": "#/$defs/name"},
        "locale": {"$ref": "#/$defs/name"},
        "seed": {"$ref": "#/$defs/uint"}
      }
    },
    "sessionEntry": {
      "description": "One committed batch of the room, in commit order. Replaying a document's entries natively (wolf transact per entry, each under the clock, timezone, locale and seed of its batch) reproduces its head sha256.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "doc_name", "revision", "base_sha256", "result_sha256", "author", "batch", "proposal_id", "approved_by", "committed_at"],
      "properties": {
        "seq": {"$ref": "#/$defs/uint"},
        "doc_name": {"$ref": "#/$defs/name"},
        "revision": {"description": "The revision this entry produced.", "type": "integer", "minimum": 1},
        "base_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "author": {"$ref": "#/$defs/actor"},
        "batch": {"$ref": "#/$defs/pinnedBatch"},
        "proposal_id": {"description": "The approved proposal this commit came from, or null for a direct commit.", "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "approved_by": {"description": "The user who approved that proposal; null exactly when proposal_id is null.", "anyOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]},
        "committed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "proposalStatus": {"enum": ["open", "approved", "rejected", "superseded", "conflicted"]},
    "proposal": {
      "description": "Edits an agent or user proposes against `base_revision` of one document, held for review instead of committed. `preview_sha256` is the sha256 of the document the batches produce on the base revision; it is null only for a rejected, superseded or conflicted proposal that never produced a preview.",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "doc_name", "base_revision", "author", "status", "batches", "preview_sha256", "created_at"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/id"},
        "doc_name": {"$ref": "#/$defs/name"},
        "base_revision": {"$ref": "#/$defs/uint"},
        "author": {"$ref": "#/$defs/actor"},
        "status": {"$ref": "#/$defs/proposalStatus"},
        "batches": {"type": "array", "items": {"$ref": "#/$defs/pinnedBatch"}},
        "preview_sha256": {"$ref": "#/$defs/optSha256"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "author", "body", "created_at"],
      "properties": {
        "message_id": {"$ref": "#/$defs/id"},
        "author": {"$ref": "#/$defs/actor"},
        "body": {"$ref": "#/$defs/text"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "thread": {
      "description": "A comment thread anchored to one address of one document. It has at least one message.",
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "doc_name", "target_address", "mentions", "messages", "resolved"],
      "properties": {
        "thread_id": {"$ref": "#/$defs/id"},
        "doc_name": {"$ref": "#/$defs/name"},
        "target_address": {"$ref": "#/$defs/name"},
        "mentions": {"type": "array", "items": {"$ref": "#/$defs/mention"}},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "resolved": {"type": "boolean"}
      }
    },
    "conflictDetail": {
      "description": "Detail of a REVISION_MISMATCH: the edit was made against `base_revision`, but the document is already at `head`. Re-read the head, rebase the batch and retry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_name", "base_revision", "head"],
      "properties": {
        "doc_name": {"$ref": "#/$defs/name"},
        "base_revision": {"$ref": "#/$defs/uint"},
        "head": {"$ref": "#/$defs/head"}
      }
    },

    "ev_room_snapshot": {
      "description": "The full room state: sent on join and whenever a client falls behind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "room"],
      "properties": {
        "type": {"const": "room.snapshot"},
        "seq": {"$ref": "#/$defs/uint"},
        "room": {"$ref": "#/$defs/roomState"}
      }
    },
    "ev_doc_added": {
      "description": "A document joined the room, at revision 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "document"],
      "properties": {
        "type": {"const": "doc.added"},
        "seq": {"$ref": "#/$defs/uint"},
        "document": {"$ref": "#/$defs/document"}
      }
    },
    "ev_doc_committed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "head", "entry"],
      "properties": {
        "type": {"const": "doc.committed"},
        "seq": {"$ref": "#/$defs/uint"},
        "head": {"$ref": "#/$defs/head"},
        "entry": {"$ref": "#/$defs/sessionEntry"}
      }
    },
    "ev_proposal_updated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "proposal"],
      "properties": {
        "type": {"const": "proposal.updated"},
        "seq": {"$ref": "#/$defs/uint"},
        "proposal": {"$ref": "#/$defs/proposal"}
      }
    },
    "ev_pages_invalidated": {
      "description": "The head of a document changed: `page_hashes` are the page hashes of the new revision, `changed` the 1-based pages whose hash differs from the previous layout (new pages count as changed), `removed` the pages that no longer exist. A client keeps painted pixels of pages whose hash is unchanged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "doc_name", "revision", "sha256", "page_hashes", "changed", "removed"],
      "properties": {
        "type": {"const": "pages.invalidated"},
        "seq": {"$ref": "#/$defs/uint"},
        "doc_name": {"$ref": "#/$defs/name"},
        "revision": {"$ref": "#/$defs/uint"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "page_hashes": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "changed": {"type": "array", "items": {"$ref": "#/$defs/page"}},
        "removed": {"type": "array", "items": {"$ref": "#/$defs/page"}}
      }
    },
    "ev_comment_updated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "thread"],
      "properties": {
        "type": {"const": "comment.updated"},
        "seq": {"$ref": "#/$defs/uint"},
        "thread": {"$ref": "#/$defs/thread"}
      }
    },
    "agentActivity": {"enum": ["reading", "searching", "inspecting", "proposing", "committing", "replying", "idle"]},
    "ev_agent_activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "seq", "agent", "doc_name", "activity", "at"],
      "properties": {
        "type": {"const": "agent.activity"},
        "seq": {"$ref": "#/$defs/uint"},
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"}}
        },
        "doc_name": {"type": ["string", "null"], "minLength": 1},
        "activity": {"$ref": "#/$defs/agentActivity"},
        "detail": {"type": "string"},
        "at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "ev_revision_mismatch": {
      "description": "Reply to a doc.edit whose base_revision is not the document's head.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code", "message", "detail"],
      "properties": {
        "type": {"const": "error"},
        "request_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "code": {"const": "REVISION_MISMATCH"},
        "message": {"type": "string"},
        "detail": {"$ref": "#/$defs/conflictDetail"}
      }
    },
    "ev_error": {
      "description": "A refused request. ENGINE_FAILED means the engine could not run the request (it crashed, timed out, reached a memory or document budget, reported an internal error, or did not reproduce a proposal's preview): nothing was stored, the request itself was not judged, and the same request can succeed later. BAD_REQUEST is a request the engine judged and refused.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code", "message"],
      "properties": {
        "type": {"const": "error"},
        "request_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "code": {"enum": ["BAD_REQUEST", "UNKNOWN_ROOM", "UNKNOWN_DOCUMENT", "UNKNOWN_PROPOSAL", "UNKNOWN_THREAD", "FORBIDDEN", "PROPOSAL_NOT_OPEN", "LICENSE_LIMIT", "ENGINE_FAILED"]},
        "message": {"type": "string"}
      }
    },
    "serverEvent": {
      "anyOf": [
        {"$ref": "#/$defs/ev_room_snapshot"},
        {"$ref": "#/$defs/ev_doc_added"},
        {"$ref": "#/$defs/ev_doc_committed"},
        {"$ref": "#/$defs/ev_proposal_updated"},
        {"$ref": "#/$defs/ev_pages_invalidated"},
        {"$ref": "#/$defs/ev_comment_updated"},
        {"$ref": "#/$defs/ev_agent_activity"},
        {"$ref": "#/$defs/ev_revision_mismatch"},
        {"$ref": "#/$defs/ev_error"}
      ]
    },

    "msg_room_join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "room_id", "since_seq"],
      "properties": {
        "type": {"const": "room.join"},
        "request_id": {"$ref": "#/$defs/id"},
        "room_id": {"$ref": "#/$defs/id"},
        "since_seq": {"description": "Last seq the client holds, or null to receive a room.snapshot.", "type": ["integer", "null"], "minimum": 0}
      }
    },
    "msg_doc_edit": {
      "description": "mode `propose` records a proposal; mode `commit` appends to the head and is refused with REVISION_MISMATCH unless `base_revision` is the head revision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "doc_name", "base_revision", "mode", "batch"],
      "properties": {
        "type": {"const": "doc.edit"},
        "request_id": {"$ref": "#/$defs/id"},
        "doc_name": {"$ref": "#/$defs/name"},
        "base_revision": {"$ref": "#/$defs/uint"},
        "mode": {"enum": ["propose", "commit"]},
        "batch": {"$ref": "#/$defs/batch"}
      }
    },
    "msg_proposal_decide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "proposal_id", "decision"],
      "properties": {
        "type": {"const": "proposal.decide"},
        "request_id": {"$ref": "#/$defs/id"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "decision": {"enum": ["approve", "reject"]}
      }
    },
    "msg_comment_post": {
      "description": "`thread_id` null opens a new thread anchored at `target_address`. `resolve` true appends the message and marks the thread resolved, and is refused on a new thread. A post without it leaves `resolved` as it was; nothing in v1 reopens a thread.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "thread_id", "doc_name", "target_address", "body", "mentions"],
      "properties": {
        "type": {"const": "comment.post"},
        "request_id": {"$ref": "#/$defs/id"},
        "thread_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "doc_name": {"$ref": "#/$defs/name"},
        "target_address": {"$ref": "#/$defs/name"},
        "body": {"$ref": "#/$defs/text"},
        "mentions": {"type": "array", "items": {"$ref": "#/$defs/mention"}},
        "resolve": {"type": "boolean"}
      }
    },
    "clientMessage": {
      "anyOf": [
        {"$ref": "#/$defs/msg_room_join"},
        {"$ref": "#/$defs/msg_doc_edit"},
        {"$ref": "#/$defs/msg_proposal_decide"},
        {"$ref": "#/$defs/msg_comment_post"}
      ]
    }
  }
}
