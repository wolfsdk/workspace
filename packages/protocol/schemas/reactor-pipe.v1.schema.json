    "res_entitlement": {
      "description": "What the running process is licensed for. `null` limits mean unlimited. A community entitlement is keyless: key_id and expires_at are null, sso and oem_offline_wasm are false, at most 1 workspace and 5 seats.",
      "type": "object",
      "required": ["cmd", "ok", "ms", "tier", "max_workspaces", "max_seats", "sso", "oem_offline_wasm", "key_id", "expires_at"],
      "properties": {
        "cmd": {"const": "entitlement"},
