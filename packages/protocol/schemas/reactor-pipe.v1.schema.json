              "page": {"$ref": "#/$defs/handle"},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "w": {"type": "number"},
              "h": {"type": "number"}
            }
          }
        }
      }
    },
    "res_text_layout": {
      "type": "object",
      "required": ["cmd", "ok", "ms", "object_id", "text", "length", "source_text", "rendered", "lines"],
      "properties": {
        "cmd": {"const": "text_layout"},
        "ok": {"const": true},
        "ms": {"$ref": "#/$defs/ms"},
        "object_id": {"$ref": "#/$defs/name"},
        "text": {"type": "string"},
        "length": {"$ref": "#/$defs/uint"},
        "source_text": {"type": "boolean"},
        "rendered": {"type": "string"},
        "lines": {"type": "array", "items": {"type": "object"}},
        "sheet": {"type": "string"},
        "a1": {"type": "string"}
      }
    },
    "res_fonts": {
      "type": "object",
      "required": ["cmd", "ok", "ms", "format", "requests", "faces"],
      "properties": {
        "cmd": {"const": "fonts"},
        "ok": {"const": true},
        "ms": {"$ref": "#/$defs/ms"},
        "format": {"$ref": "#/$defs/format"},
        "requests": {"type": "array", "items": {"type": "object"}},
        "faces": {"type": "array", "items": {"type": "object"}}
