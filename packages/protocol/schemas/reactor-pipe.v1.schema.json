        "cols": {"$ref": "#/$defs/uint"},
        "cells": {"type": "array", "items": {"type": "object"}},
        "columns": {"type": "array", "items": {"type": "object"}},
        "row_heights": {"type": "array", "items": {"type": "object"}},
        "merged": {"type": "array", "items": {"type": "string"}},
        "styles": {"type": "object"},
        "revision": {"$ref": "#/$defs/uint"}
      }
