      "type": "object",
      "required": ["cmd", "ok", "ms", "sheet", "sheets", "row0", "col0", "rows", "cols", "cells", "columns", "row_heights", "merged", "styles", "revision"],
      "properties": {
        "cmd": {"const": "sheet_viewport"},
        "ok": {"const": true},
        "ms": {"$ref": "#/$defs/ms"},
        "sheet": {"type": "string"},
        "sheets": {"type": "array", "items": {"type": "object"}},
        "used_range": {"type": ["string", "null"]},
        "row0": {"$ref": "#/$defs/positive"},
