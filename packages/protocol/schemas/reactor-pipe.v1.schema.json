        {"$ref": "#/$defs/res_hit_test"},
        {"$ref": "#/$defs/res_caret_rects"},
        {"$ref": "#/$defs/res_text_layout"},
        {"$ref": "#/$defs/res_fonts"},
        {"$ref": "#/$defs/res_resource"},
        {"$ref": "#/$defs/res_sheet_viewport"},
        {"$ref": "#/$defs/res_entitlement"}
      ]
    },

    "requestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "kind", "header", "body"],
      "properties": {
        "contract": {"const": "wolfsdk.reactor-pipe.v1"},
