        "rendered_offset": {"$ref": "#/$defs/optUint"},
        "synthetic": {"type": "boolean"},
        "inside_text": {"type": "boolean"},
        "run": {"$ref": "#/$defs/uint"},
        "run_offset": {"$ref": "#/$defs/uint"},
        "caret": {"$ref": "#/$defs/rect"},
        "sheet": {"type": "string"},
        "a1": {"type": "string"}
