        "ms": {"$ref": "#/$defs/ms"},
        "tier": {"$ref": "#/$defs/tier"},
        "max_workspaces": {"$ref": "#/$defs/optUint"},
        "max_seats": {"$ref": "#/$defs/optUint"},
        "sso": {"type": "boolean"},
        "oem_offline_wasm": {"type": "boolean"},
        "key_id": {"$ref": "#/$defs/optString"},
        "expires_at": {"$ref": "#/$defs/optClock"}
      }
    },
    "response": {
      "anyOf": [
        {"$ref": "#/$defs/res_error"},
        {"$ref": "#/$defs/res_version"},
        {"$ref": "#/$defs/res_budget"},
        {"$ref": "#/$defs/res_open"},
        {"$ref": "#/$defs/res_close"},
        {"$ref": "#/$defs/res_save"},
        {"$ref": "#/$defs/res_history"},
